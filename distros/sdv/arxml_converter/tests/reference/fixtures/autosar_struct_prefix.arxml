<?xml version="1.0" encoding="utf-8"?>
<!-- Locally authored ARXML adaptation of the finite prefix in AUTOSAR FO
     R24-11 SOME/IP Protocol, section 4.1.4.2, Figure 4.1 (page 29).
     Struct_2's unspecified Struct_3 member is intentionally outside this
     prefix fixture. This is not an official distributed ARXML file. -->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00048.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>dataTypes</SHORT-NAME>
      <ELEMENTS>
        <STD-CPP-IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>Uint32</SHORT-NAME>
          <CATEGORY>TYPE_REFERENCE</CATEGORY>
          <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint32_t</TYPE-REFERENCE-REF>
          <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
        </STD-CPP-IMPLEMENTATION-DATA-TYPE>
        <STD-CPP-IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>Float32</SHORT-NAME>
          <CATEGORY>TYPE_REFERENCE</CATEGORY>
          <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/float</TYPE-REFERENCE-REF>
          <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
        </STD-CPP-IMPLEMENTATION-DATA-TYPE>
        <STD-CPP-IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>FloatPair</SHORT-NAME>
          <CATEGORY>ARRAY</CATEGORY>
          <ARRAY-SIZE>2</ARRAY-SIZE>
          <TEMPLATE-ARGUMENTS>
            <CPP-TEMPLATE-ARGUMENT>
              <INPLACE>false</INPLACE>
              <TEMPLATE-TYPE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/dataTypes/Float32</TEMPLATE-TYPE-REF>
            </CPP-TEMPLATE-ARGUMENT>
          </TEMPLATE-ARGUMENTS>
          <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
        </STD-CPP-IMPLEMENTATION-DATA-TYPE>
        <STD-CPP-IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>Struct2Prefix</SHORT-NAME>
          <CATEGORY>STRUCTURE</CATEGORY>
          <SUB-ELEMENTS>
            <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
              <SHORT-NAME>d</SHORT-NAME>
              <TYPE-REFERENCE>
                <INPLACE>false</INPLACE>
                <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/dataTypes/Uint32</TYPE-REFERENCE-REF>
              </TYPE-REFERENCE>
            </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
              <SHORT-NAME>e</SHORT-NAME>
              <TYPE-REFERENCE>
                <INPLACE>false</INPLACE>
                <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/dataTypes/FloatPair</TYPE-REFERENCE-REF>
              </TYPE-REFERENCE>
            </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
          </SUB-ELEMENTS>
          <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
        </STD-CPP-IMPLEMENTATION-DATA-TYPE>
        <STD-CPP-IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>Struct1Prefix</SHORT-NAME>
          <CATEGORY>STRUCTURE</CATEGORY>
          <SUB-ELEMENTS>
            <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
              <SHORT-NAME>a</SHORT-NAME>
              <TYPE-REFERENCE>
                <INPLACE>false</INPLACE>
                <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/dataTypes/Uint32</TYPE-REFERENCE-REF>
              </TYPE-REFERENCE>
            </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
              <SHORT-NAME>b</SHORT-NAME>
              <TYPE-REFERENCE>
                <INPLACE>false</INPLACE>
                <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/dataTypes/FloatPair</TYPE-REFERENCE-REF>
              </TYPE-REFERENCE>
            </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
              <SHORT-NAME>c</SHORT-NAME>
              <TYPE-REFERENCE>
                <INPLACE>false</INPLACE>
                <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/dataTypes/Struct2Prefix</TYPE-REFERENCE-REF>
              </TYPE-REFERENCE>
            </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
          </SUB-ELEMENTS>
          <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
        </STD-CPP-IMPLEMENTATION-DATA-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>AUTOSAR</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>StdTypes</SHORT-NAME>
          <ELEMENTS>
            <STD-CPP-IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>uint32_t</SHORT-NAME>
              <CATEGORY>VALUE</CATEGORY>
              <TYPE-EMITTER>cstdint</TYPE-EMITTER>
            </STD-CPP-IMPLEMENTATION-DATA-TYPE>
            <STD-CPP-IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>float</SHORT-NAME>
              <CATEGORY>VALUE</CATEGORY>
              <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
            </STD-CPP-IMPLEMENTATION-DATA-TYPE>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
