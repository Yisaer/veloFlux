    {
      "id": "official_struct_prefix",
      "source": {
        "kind": "official_adaptation",
        "url": "https://www.autosar.org/fileadmin/standards/R24-11/FO/AUTOSAR_FO_PRS_SOMEIPProtocol.pdf",
        "section": "4.1.4.2, Figure 4.1, page 29",
        "note": "Locally authored ARXML for the finite illustrated prefix. Struct_3 is unspecified in the figure and excluded; this is not official ARXML."
      },
      "input": {
        "file": "fixtures/autosar_struct_prefix.arxml",
        "strict": true,
        "query": {
          "operation": "ap_type",
          "type_path": "/dataTypes/Struct1Prefix"
        }
      },
      "comparison": "equal",
      "expected": {
        "both": {
          "ok": {
            "name": "Struct1Prefix",
            "category": "STRUCTURE",
            "definition": {
              "kind": "structure",
              "fields": [
                {
                  "name": "a",
                  "target": "Uint32",
                  "in_place": false
                },
                {
                  "name": "b",
                  "target": "FloatPair",
                  "in_place": false
                },
                {
                  "name": "c",
                  "target": "Struct2Prefix",
                  "in_place": false
                }
              ]
            }
          }
        }
      }
    },
