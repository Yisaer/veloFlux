    {
      "id": "cp_minimal_missing_header_metadata",
      "source": {
        "kind": "repository",
        "url": "https://github.com/Yisaer/veloFlux",
        "note": "Existing minimal fixture with type references corrected to actual package paths; missing ARXML header preserved."
      },
      "input": {
        "file": "../test_data/minimal_cp.arxml",
        "strict": true,
        "query": {
          "operation": "resolve_cp",
          "service_id": 10,
          "header_id": 100
        }
      },
      "comparison": "known_difference",
      "reason": "The minimal fixture lacks the ARXML header required by autosar-data; type references now identify their actual package paths.",
      "expected": {
        "rust": {
          "ok": {
            "name": "SpeedType",
            "category": "VALUE",
            "definition": {
              "kind": "reference",
              "target": "uint32",
              "string_size": null
            }
          }
        },
        "python": {
          "error_contains": "bad file header"
        }
      }
    },
